@startuml contexto_con_puertos
!theme plain
skinparam componentStyle rectangle

title Ejemplo Tip 3-8: Agregación con Puertos UML

component "Sistema\nPrincipal" as system #lightblue {
  portin "Datos de\nEntrada" as input
  portout "Reportes" as reports
  portout "Notificaciones" as notify
}

' Sistemas agrupados por puerto
package "Proveedores de Datos" {
  component "Sistema A" as sysA
  component "Sistema B" as sysB
  component "Sistema C" as sysC
}

package "Consumidores de Reportes" {
  component "Dashboard" as dash
  component "BI Tool" as bi
}

package "Canales de Notificación" {
  component "Email" as email
  component "SMS" as sms
  component "Push" as push
}

' Conexiones a puertos
sysA --> input
sysB --> input
sysC --> input

reports --> dash
reports --> bi

notify --> email
notify --> sms
notify --> push

note right of system
  **Ventaja de Puertos:**
  
  Agrupa múltiples sistemas
  externos similares sin
  sobrecargar el diagrama.
  
  Similar a Tip 3-7 pero
  sin necesidad de estereotipos.
end note

note bottom of input
  Puerto de entrada:
  Recibe datos de múltiples fuentes
end note

@enduml
