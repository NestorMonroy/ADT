@startuml contexto_negocio_vs_tecnico
!theme plain
skinparam componentStyle rectangle

title Ejemplo Tip 3-10: Contexto de Negocio vs Técnico

package "CONTEXTO DE NEGOCIO" {
  actor "Usuario\nWeb" as user1
  actor "Administrador" as admin1
  component "Sistema\nWeb" as websys1 #lightblue
  component "Sistema de\nReportes" as reporting1
  database "Base de\nDatos" as db1
  
  user1 --> websys1 : Usa aplicación
  admin1 --> websys1 : Administra
  websys1 --> reporting1 : Solicita\nreportes
  websys1 --> db1 : Lee/Escribe\ndatos
  
  note right of websys1
    **Vista de Negocio:**
    - Se enfoca en funcionalidad
    - Ignora protocolos técnicos
    - Muestra flujos de datos
  end note
}

package "CONTEXTO TÉCNICO" {
  node "Navegador\nCliente" as browser
  node "Servidor Web\n(Apache)" as webserver #lightblue
  node "Servidor de\nReportes\n(mismo servidor)" as reporting2 #lightgreen
  database "PostgreSQL\nServer" as dbserver
  
  browser -[#blue]-> webserver : HTTPS\n(puerto 443)
  webserver -[#orange]-> dbserver : TCP/IP\n(puerto 5432)
  webserver -[#green]-> reporting2 : RPC local
  
  note right of webserver
    **Vista Técnica:**
    - Protocolos: HTTPS, SSH, TCP/IP
    - Puertos y canales
    - Hardware/infraestructura
    - Deployment
  end note
  
  note bottom of reporting2
    Desde el punto de vista técnico,
    Reporting está en el MISMO servidor
    que el sistema principal
  end note
}

@enduml
