# ============================================================================
# FRONTMATTER - Metadata del Skill
# ============================================================================
# Reemplazar todos los placeholders [entre corchetes]
# Mantener formato YAML estricto (indentación con espacios)

name: [nombre-del-skill]
# Reglas para name:
# - Solo minúsculas, números y guiones (-)
# - NO usar espacios, underscores o caracteres especiales
# - Máximo 64 caracteres
# - Descriptivo y único
# Ejemplo: commit-helper, translation-workflow, anthropic-best-practices

description: "[Descripción breve del skill en una oración]. Usar cuando [trigger específico]."
# Reglas para description:
# - Máximo 1024 caracteres
# - Debe incluir QUÉ hace el skill y CUÁNDO usarlo
# - Escribir en tercera persona (NO "Yo ayudo", SÍ "Ayuda a...")
# - Ser específico con triggers/contextos
# Ejemplo: "Ayuda a crear commits siguiendo Conventional Commits. Usar cuando el usuario necesite hacer un commit o escribir un mensaje de commit."

version: 1.0.0
# Formato: MAJOR.MINOR.PATCH (semántico)
# - MAJOR: Cambios incompatibles
# - MINOR: Nueva funcionalidad compatible
# - PATCH: Correcciones de bugs
# Iniciar siempre en 1.0.0

created: [YYYY-MM-DD]
# Fecha de creación del skill (formato ISO)

updated: [YYYY-MM-DD]
# Última fecha de actualización (mismo que created inicialmente)

